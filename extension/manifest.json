{
  "manifest_version": 3,
  "name": "EchoGPT",
  "version": "1.0.0",
  "description": "Your AI-powered assistant in the side panel",
  "icons": {
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Open EchoGPT",
    "default_icon": "images/icon-128.png"
  },
  "permissions": [
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}